PORT=4000
# Atlas: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/portal-contadores?retryWrites=true&w=majority
MONGO_URI=mongodb://mongo:27017/portal-contadores
# Gere com: openssl rand -hex 32 (mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=15m
GOOGLE_CLIENT_ID=
# Mercado Pago: use Access Token de TESTE em dev e de PRODUÇÃO em produção.
# A Public Key em frontend/cobrar/.env.local deve ser do mesmo ambiente.
MP_ACCESS_TOKEN=
# Segredo do webhook (Painel MP > Notificações > Webhooks)
MP_WEBHOOK_SECRET=troque-este-webhook-secret
# Em produção use https://seu-dominio (o boot recusa localhost).
# No Render + Vercel: FRONTEND_URL=https://SEU-PROJETO.vercel.app
FRONTEND_URL=http://localhost:3000
# URL pública da API (links de confirmação de e-mail).
# Vazio no mesmo domínio; no Render, RENDER_EXTERNAL_URL é detectado automaticamente.
BACKEND_URL=
# Origens extras de CORS separadas por vírgula (ex.: previews da Vercel).
CORS_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido (padrão: SMTP_USER); no Render use o mesmo e-mail verificado no provedor
SMTP_FROM=
# 1 atrás do nginx; 2 se houver Cloudflare/Caddy na frente
TRUST_PROXY=1
# Antecedência (dias) dos lembretes de documentos e da renovação automática
REMINDER_DAYS_BEFORE=3
RENEWAL_DAYS_BEFORE=3
UPLOADS_DIR=./uploads
