# Vazio = same-origin (proxy do CRA/nginx). Na Vercel use a URL do Render, sem barra no final:
# REACT_APP_API_URL=https://SEU-BACKEND.onrender.com
REACT_APP_API_URL=
PORT=3000
# Public Key do Mercado Pago (mesmo ambiente do MP_ACCESS_TOKEN do backend)
REACT_APP_MERCADOPAGO_PUBLIC_KEY=TEST-public-key
# OAuth Client ID (Web) do Google Cloud Console > Credentials
REACT_APP_GOOGLE_CLIENT_ID=
