# Variáveis lidas pelo docker compose (copie para .env)
# Uso: docker compose --env-file .env up -d --build

# URL pública do site (frontend + API no mesmo domínio via nginx).
# Obrigatória em produção, com HTTPS. Ex.: https://app.seudominio.com
PUBLIC_URL=https://app.seudominio.com

# Deixe vazio: frontend chama /api e /uploads no mesmo domínio (proxy do nginx)
REACT_APP_API_URL=
REACT_APP_GOOGLE_CLIENT_ID=400309681982-j8rcle3s8g406ust15mgv6ksu2v90gem.apps.googleusercontent.com
REACT_APP_MERCADOPAGO_PUBLIC_KEY=
